local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local PathfindingService = game:GetService("PathfindingService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

-- Xóa menu cũ nếu chạy lại
if CoreGui:FindFirstChild("HalloweenDoorHub") then
    CoreGui.HalloweenDoorHub:Destroy()
end

-- Quản lý trạng thái và cấu hình
local Manager = {
    ActiveDoors = {},
    Connections = {},
    CurrentPathWaypoints = nil,
    GUI = {},
    Config = {
        DOORS_PATH = workspace:WaitForChild("Map"):WaitForChild("Core"):WaitForChild("HalloweenDoors"),
        AUTO_FARM_TOGGLE_KEY = Enum.KeyCode.K,
        AutoFarmEnabled = false,
        FARM_SPEED = 130,
        NORMAL_SPEED = 26,
        FARM_TRIGGER_DISTANCE = 5,
        PROMPT_TIMEOUT = 1,
        WAYPOINT_TIMEOUT = 1,
        WAYPOINT_ACCEPTANCE_RADIUS = 5,
        NEW_DOOR_WAIT_TIME = 1,
        SERVER_HOP_ENABLED = true,
        SERVER_HOP_TIMEOUT = 5,
        PATH_COLOR = Color3.fromRGB(70, 255, 170),
        PATH_THICKNESS = 0.6,
        PATH_TRANSPARENCY = 0.5,
    }
}

-- Hàm hỗ trợ Queue on Teleport (Đổi server giữ nguyên trạng thái)
local function getQueueOnTeleport()
    local funcs = {wave, Wave, syn, fluxus, fluss, queue_on_teleport, executor}
    for _, provider in ipairs(funcs) do
        if type(provider) == "table" and type(provider.queue_on_teleport) == "function" then
            return provider.queue_on_teleport
        end
    end
    if type(queue_on_teleport) == "function" then
        return queue_on_teleport
    end
    return nil
end

local function queueAutoFarmScript()
    local qot = getQueueOnTeleport()
    if qot then
        pcall(function()
            qot([[
                _G = _G or {}
                task.spawn(function()
                    _G.AutoFarmQueued = true
                end)
            ]])
        end)
    end
end

LocalPlayer.OnTeleport:Connect(function(teleportState)
    if teleportState == Enum.TeleportState.Started then
        pcall(queueAutoFarmScript)
    end
end)

